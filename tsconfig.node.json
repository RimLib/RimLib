{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "electron", "electron-vite/node"],
    "outDir": "dist-types/node"
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vite.renderer.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
